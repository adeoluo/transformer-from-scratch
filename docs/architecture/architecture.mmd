flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["CLI & Benchmarks"]
        direction TB
        CLI["CLI<br/>train, evaluate, generate, attention"]:::edge
        Bench["Benchmarks<br/>text LM, 8-seed ablation"]:::edge
        CLI ~~~ Bench
    end

    subgraph Model["Data, Autodiff & Model"]
        direction TB
        Copy[("Copy task<br/>disjoint splits")]:::data
        Corpus[("Real text<br/>Austen excerpt")]:::data
        Tensor["Autodiff engine<br/>2-D NumPy backward"]:::core
        Net["Transformer<br/>pre-norm, causal MHA"]:::core
        Copy ~~~ Corpus
        Tensor --> Net
    end

    subgraph Train["Training & State"]
        direction TB
        Loop["Training loop<br/>Adam from scratch"]:::core
        TextLM["Character LM<br/>train_char_lm"]:::core
        Ckpt[("JSON checkpoint<br/>save / load")]:::data
        TextLM ~~~ Loop --> Ckpt
    end

    subgraph Obs["Verification & Analysis"]
        direction TB
        Evaluate["Evaluation<br/>copy acc, bits per char"]:::obs
        Inspect["Attention inspection<br/>sharpest head"]:::obs
        Research["Research study<br/>ablation, depth, mixer"]:::obs
        Parity["PyTorch parity<br/>forward + 48 grads &lt; 1e-9"]:::obs
        Evaluate ~~~ Inspect ~~~ Research ~~~ Parity
    end

    Interfaces -->|run| Train
    Model -->|sequences, model| Train
    Train -->|trained models| Obs
